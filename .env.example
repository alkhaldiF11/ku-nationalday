# ── Production (Vercel) ─────────────────────────────────────────────────────────
# Turso database. Added automatically by Vercel's Turso integration, or copy them from
# the Turso dashboard (database → Connect). Without these, a local SQLite file is used.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob (private photo storage). Added automatically when you connect a Blob store
# to the project in Vercel (Storage → Blob). Without it, photos are stored under DATA_DIR.
BLOB_READ_WRITE_TOKEN=

# ── Local development ───────────────────────────────────────────────────────────
# Where the local SQLite database and photos live when the variables above are empty.
DATA_DIR=data

# ── Both ────────────────────────────────────────────────────────────────────────
# Initial administrator password, used only when the database is first created.
# Set this before the first visit in any real deployment; otherwise the demo password applies.
ADMIN_INITIAL_PASSWORD=

# A new database gets only the admin account. "true" adds demo guests, staff, announcements
# and gallery art (used by the automated tests; don't enable it for the real site).
SEED_DEMO_DATA=false

# Show demo staff credentials on the staff sign-in page. Never enable in production.
SHOW_DEMO_CREDENTIALS=false

# Session cookies are marked Secure in production. Set to "true" only if you must
# serve production over plain HTTP on a private network (e.g. a venue LAN without TLS).
INSECURE_COOKIES=false
